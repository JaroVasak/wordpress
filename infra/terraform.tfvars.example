server_name  = "wordpress-prod"
server_type  = "cx23"
server_image = "ubuntu-24.04"
location     = "nbg1"
ssh_key_name = "hetzner-wordpress"

repository_url = "https://github.com/JaroVasak/wordpress.git"
repository_ref = "main"

# Optional: seed a new SSH firewall. Later changes are made in the Hetzner GUI.
# An empty list creates the firewall without SSH access until configured in the GUI.
ssh_allowed_cidrs = []

enable_ipv6              = true
enable_backups           = false
enable_server_protection = true
