{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "helpers:pinGitHubActionDigests"],
  "timezone": "Europe/Prague",
  "automerge": false,
  "automergeType": "pr",
  "automergeStrategy": "rebase",
  "platformAutomerge": true,
  "separateMajorMinor": true,
  "dependencyDashboardApproval": false,
  "ignoreUnstable": true,
  "dependencyDashboard": {"enabled": true},
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "enabledManagers": ["docker-compose", "github-actions", "terraform", "mise", "custom.regex"],
  "ignorePaths": ["sites/**", "backups/**", "**/.terraform/**"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s+[A-Z_]+: \\S+:(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Automerge only patch/minor updates and pin maintenance for explicitly selected CI tools",
      "matchManagers": ["github-actions", "custom.regex"],
      "matchPackageNames": [
        "actions/*",
        "hashicorp/setup-terraform",
        "renovatebot/github-action",
        "aquasecurity/trivy-action",
        "aquasecurity/trivy",
        "ghcr.io/renovatebot/renovate",
        "rhysd/actionlint"
      ],
      "matchUpdateTypes": ["patch", "minor", "digest", "pin", "pinDigest"],
      "automerge": true
    },
    {
      "description": "Major updates always require a manual merge",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Keep every copy of each container image in the same PR",
      "matchManagers": ["docker-compose"],
      "groupName": "{{depName}} container images"
    },
    {
      "description": "Keep the Terraform CLI pins in mise, Terraform, and CI together",
      "matchPackageNames": ["hashicorp/terraform", "terraform"],
      "groupName": "Terraform CLI"
    },
    {
      "description": "Update the Renovate runner and config validator together",
      "matchPackageNames": ["ghcr.io/renovatebot/renovate"],
      "groupName": "Renovate runtime"
    },
    {
      "description": "Nginx stable branches have an even minor version; keep the Alpine slim variant",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["nginx"],
      "allowedVersions": "/^\\d+\\.(?:\\d*[02468])\\.\\d+-alpine-slim$/"
    },
    {
      "description": "Database upgrades remain manual, including patch updates",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["mariadb"],
      "enabled": false
    }
  ]
}
